{
  "schema": 1,
  "name": "release_v15",
  "preset": "onyx.json",
  "size": "1080x1920",
  "target": 47.0,
  "fps": 30,
  "bpm": 120,
  "voice": "en_US-lessac-medium",
  "music": { "bed": "pulse" },
  "vo_lines": [
    { "shot": 0, "offset": 0.45, "text": "Do you want to generate a video like this?" },
    { "shot": 1, "offset": 0.6, "text": "This is LEEBKIT. An offline video generator for still images." },
    { "shot": 2, "offset": 0.5, "text": "No APIs. No cloud. No account. Your machine, your renders." },
    { "shot": 3, "offset": 0.6, "text": "Slam. Glitch. Burst. Punch. Words that move like you mean it." },
    { "shot": 4, "offset": 0.7, "text": "Live equalizer bars ride your voice. Terminal rows type themselves." },
    { "shot": 5, "offset": 0.6, "text": "And captions now place anywhere on frame — top, bottom, or right on the beat." },
    { "shot": 6, "offset": 0.6, "text": "One JSON file. One command. Fully offline. Free forever." },
    { "shot": 7, "offset": 0.5, "text": "Get LEEBKIT on GitHub. Version one point five is out now." }
  ],
  "shots": [
    {
